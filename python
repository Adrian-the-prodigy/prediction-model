import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import Ridge, LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import cross_val_score
import ccxt
from datetime import datetime, timedelta
import ccxt
import pandas as pd
import ta

# Initialize the exchange
exchange = ccxt.binance({
    'rateLimit': 1200,
    'enableRateLimit': True,
})

# Define the symbol and timeframe
symbol = 'BTC/USDT'
timeframe = '1h'

# Fetch OHLCV data
ohlcv = exchange.fetch_ohlcv(symbol, timeframe)

# Create a DataFrame
df = pd.DataFrame(ohlcv, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
df['timestamp'] = pd.to_datetime(df['timestamp'], unit='ms')

# Calculate RSI
rsi_period = 14
df['rsi'] = ta.momentum.RSIIndicator(df['close'], rsi_period).rsi()

# Calculate Stochastic Oscillator
stoch_k_period = 14
stoch_d_period = 3
stoch = ta.momentum.StochasticOscillator(
    high=df['high'],
    low=df['low'],
    close=df['close'],
    window=stoch_k_period,
    smooth_window=stoch_d_period
)
df['stoch_k'] = stoch.stoch()
df['stoch_d'] = stoch.stoch_signal()

# Calculate Williams %R
williams_r_period = 14
df['williams_r'] = ta.momentum.WilliamsRIndicator(
    high=df['high'],
    low=df['low'],
    close=df['close'],
    lbp=williams_r_period
).williams_r()

# Calculate MACD
macd = ta.trend.MACD(df['close'])
df['macd'] = macd.macd()
df['macd_signal'] = macd.macd_signal()
df['macd_hist'] = macd.macd_diff()  # MACD histogram

# Get the latest values
latest_rsi = df['rsi'].iloc[-1]
latest_stoch_d = df['stoch_d'].iloc[-1]
latest_williams_r = df['williams_r'].iloc[-1]
latest_macd = df['macd'].iloc[-1]
latest_macd_signal = df['macd_signal'].iloc[-1]
latest_macd_hist = df['macd_hist'].iloc[-1]

# Initialize the Binance exchange
binance = ccxt.binance()

# Set the symbol to fetch (BTC/USDT for Bitcoin)
symbol = 'BTC/USDT'

# Get the timestamp for three days ago
since = binance.parse8601((datetime.now() - timedelta(days=3)).isoformat())

# Fetch OHLCV data (Open, High, Low, Close, Volume) for the symbol
ohlcv = binance.fetch_ohlcv(symbol, timeframe='1h', since=since)

# Extract closing prices and convert to integers
closing_prices = [int(candle[4]) for candle in ohlcv]

# Prepare the data
Days_passed = np.arange(len(closing_prices)).reshape(-1, 1)
market_values = np.array(closing_prices)

# Create a polynomial regression model with Ridge regularization
model = Ridge(alpha=0.1)  # Adjust alpha for more or less regularization

# Create higher degree polynomial features
poly_features = PolynomialFeatures(degree=10)
Days_passed_poly = poly_features.fit_transform(Days_passed)

# Use cross-validation to estimate performance
mse_scores = -cross_val_score(model, Days_passed_poly, market_values, cv=5, scoring='neg_mean_squared_error')
average_mse = np.mean(mse_scores)

# Fit the model to the polynomial features
model.fit(Days_passed_poly, market_values)

# Predict the next 3 days
new_days = np.array(range(len(market_values) + 1, len(market_values) + 4)).reshape(-1, 1)
new_days_poly = poly_features.transform(new_days)  # Transform new days with the polynomial features
predicted_valuess = model.predict(new_days_poly)

# Plot the data points with lines connecting them
plt.figure(figsize=(12, 6))
plt.scatter(Days_passed, market_values, label="Data Points", color='blue')
plt.plot(Days_passed, market_values, color='blue', alpha=0.3, linestyle='--')

# Plot the regression line
plt.plot(Days_passed, model.predict(Days_passed_poly), color='red', label="Regression Line")

# Plot the predicted values as points
plt.scatter(new_days, predicted_valuess, label="Predicted Values", color='green', marker='x')

# Connect data points with lines
for i in range(len(Days_passed) - 1):
    plt.plot([Days_passed[i], Days_passed[i + 1]], [market_values[i], market_values[i + 1]], color='blue', alpha=0.3, linestyle='--')

# Connect predicted values to the last data point
plt.plot([Days_passed[-1], new_days[0]], [market_values[-1], predicted_valuess[0]], color='green', alpha=0.5, linestyle='--')

plt.xlabel("Days")
plt.ylabel("Market Values")
plt.legend()
plt.show()

